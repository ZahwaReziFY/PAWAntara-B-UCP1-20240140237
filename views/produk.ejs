<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/header', { title: title }) %>
</head>
<body class="bg-cream text-ink font-sans">
  <%- include('partials/navbar') %>

  <main class="max-w-5xl mx-auto px-5 pb-12">
    <section class="mt-8" aria-labelledby="produk-title">
      <h1 id="produk-title" class="text-2xl font-bold text-primary-dark">Daftar Produk</h1>
      <p class="text-muted">Cek stok dan harga terbaru dari Toko Sembako Ariesta.</p>
    </section>

    <!-- Form filter: Flexbox, wrap ke kolom di mobile -->
    <section class="mt-6" aria-labelledby="filter-title">
      <h2 id="filter-title" class="sr-only">Filter Produk</h2>
      <form id="filter-form" action="/produk" method="GET" class="bg-white border border-accent-light rounded-xl p-5 flex flex-wrap md:flex-nowrap items-end gap-4" novalidate>
        <div class="flex flex-col gap-1 flex-1 min-w-[180px]">
          <label for="search" class="text-sm font-semibold text-muted">Cari nama produk</label>
          <input
            type="text"
            id="search"
            name="search"
            placeholder="cth: beras, minyak..."
            value="<%= searchAktif %>"
            aria-describedby="search-error"
            class="border border-accent-light rounded-lg px-3 py-2 bg-cream focus:outline-none focus:ring-2 focus:ring-primary"
          />
          <p id="search-error" class="hidden text-xs text-red-600 mt-1" role="alert">Nama produk harus diisi/kategori harus dipilih</p>
        </div>

        <div class="flex flex-col gap-1 min-w-[180px]">
          <label for="kategori" class="text-sm font-semibold text-muted">Kategori</label>
          <select id="kategori" name="kategori" class="border border-accent-light rounded-lg px-3 py-2 bg-cream focus:outline-none focus:ring-2 focus:ring-primary">
            <option value="" <%= kategoriAktif === '' ? 'selected' : '' %>>Semua Kategori</option>
            <option value="sembako" <%= kategoriAktif === 'sembako' ? 'selected' : '' %>>Sembako</option>
            <option value="rumah-tangga" <%= kategoriAktif === 'rumah-tangga' ? 'selected' : '' %>>Rumah Tangga</option>
          </select>
        </div>

        <button type="submit" class="bg-accent hover:bg-accent/90 text-white font-semibold px-5 py-2.5 rounded-lg">Terapkan Filter</button>
        <% if (searchAktif || kategoriAktif) { %>
          <a href="/produk" class="bg-accent-light hover:bg-accent-light/70 text-primary-dark font-semibold px-5 py-2.5 rounded-lg">Reset</a>
        <% } %>
      </form>
    </section>

    <!-- Grid hasil produk: CSS Grid, responsif 1 / 2 / 3 kolom -->
    <section class="mt-8" aria-labelledby="hasil-title">
      <h2 id="hasil-title" class="sr-only">Hasil Produk</h2>

      <% if (products.length === 0) { %>
        <p class="italic text-muted mt-6">Tidak ada produk yang cocok dengan pencarianmu.</p>
      <% } else { %>
        <p id="hasil-count" class="text-sm text-muted mb-3"></p>
        <div id="hasil-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          <% products.forEach(function(p) { %>
            <article class="product-card bg-white border border-accent-light rounded-xl p-5 shadow-sm flex flex-col gap-1">
              <span class="self-start bg-primary text-white text-[11px] font-semibold uppercase tracking-wide px-2.5 py-0.5 rounded-full mb-1">
                <%= p.category === 'sembako' ? 'Sembako' : 'Rumah Tangga' %>
              </span>
              <h3 class="product-name font-semibold"><%= p.name %></h3>
              <p class="text-accent font-bold"><%= 'Rp ' + p.price.toLocaleString('id-ID') %></p>
              <p class="text-sm text-muted mb-2">Stok: <%= p.stock %></p>
              <a href="/produk/<%= p.id %>" class="inline-block bg-accent-light hover:bg-accent-light/70 text-primary-dark font-semibold px-4 py-2 rounded-lg text-sm w-fit">Lihat Detail</a>
            </article>
          <% }); %>
        </div>
      <% } %>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
  <script src="/js/produk.js"></script>
</body>
</html>