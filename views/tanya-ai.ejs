<!DOCTYPE html>
<html lang="id">
<head>
  <%- include('partials/header', { title: title }) %>
</head>
<body class="bg-cream text-ink font-sans">
  <%- include('partials/navbar') %>

  <main class="max-w-5xl mx-auto px-5 pb-12">
    <section class="mt-8" aria-labelledby="ai-title">
      <h1 id="ai-title" class="text-2xl font-bold text-primary-dark">Tanya AI</h1>
      <p class="text-muted">Punya pertanyaan seputar jam buka, ongkir, atau stok? Tanyakan di sini.</p>
    </section>

    <section class="mt-6" aria-labelledby="chat-title">
      <h2 id="chat-title" class="sr-only">Ruang Percakapan</h2>

      <div id="chat-window" class="bg-white border border-accent-light rounded-xl p-5 min-h-[200px] flex flex-col gap-2.5" aria-live="polite">
        <div class="chat-bubble max-w-[70%] self-start bg-accent-light text-ink px-4 py-2.5 rounded-2xl rounded-bl-sm text-sm">
          <p>Halo! Aku asisten Toko Sembako Ariesta. Silakan tanyakan sesuatu ya 🙂</p>
        </div>
        <p class="text-xs text-muted mt-2">
          <!-- SPRINT 1: tampilan saja. SPRINT 2: balasan asli dari POST /api/chat -->
          Catatan: fitur balasan otomatis akan aktif di sesi berikutnya (Sprint 2).
        </p>
      </div>

      <!-- Form chat: Flexbox, stack di mobile -->
      <form id="chat-form" class="flex flex-col md:flex-row md:items-end gap-4 mt-4" aria-label="Form Tanya AI">
        <div class="flex flex-col gap-1 flex-1">
          <label for="pertanyaan" class="text-sm font-semibold text-muted">Tulis pertanyaanmu</label>
          <textarea
            id="pertanyaan"
            name="pertanyaan"
            rows="2"
            placeholder="cth: Toko buka jam berapa?"
            required
            class="border border-accent-light rounded-lg px-3 py-2 bg-white focus:outline-none focus:ring-2 focus:ring-primary resize-none"
          ></textarea>
        </div>
        <button type="submit" class="bg-accent hover:bg-accent/90 text-white font-semibold px-5 py-2.5 rounded-lg h-fit">Kirim</button>
      </form>
    </section>
  </main>

  <%- include('partials/footer') %>
  <script src="/js/main.js"></script>
</body>
</html>
