<header class="sticky top-0 z-20 bg-white border-b border-accent-light font-sans">
  <!-- Flexbox: brand kiri, hamburger kanan (mobile), menu kanan (desktop) -->
  <div class="max-w-5xl mx-auto px-5 py-3 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2 font-bold text-primary-dark">
      <span class="text-xl">🌾</span>
      <span>Toko Sembako Ariesta</span>
    </a>

    <!-- Hamburger: cuma muncul di mobile (di bawah breakpoint md) -->
    <button
      id="hamburger-btn"
      class="hamburger-btn md:hidden flex flex-col justify-center gap-[5px] w-8 h-8"
      aria-label="Buka menu navigasi"
      aria-expanded="false"
      aria-controls="main-nav"
    >
      <span class="bar block w-full h-[2.5px] bg-primary-dark rounded transition-transform duration-200"></span>
      <span class="bar block w-full h-[2.5px] bg-primary-dark rounded transition-opacity duration-200"></span>
      <span class="bar block w-full h-[2.5px] bg-primary-dark rounded transition-transform duration-200"></span>
    </button>

    <!-- Nav desktop: flex, selalu tampil di md ke atas -->
    <!-- Nav mobile: hidden by default, di-toggle JS jadi block di bawah navbar -->
    <nav
      id="main-nav"
      aria-label="Navigasi utama"
      class="hidden md:flex md:flex-row md:items-center md:gap-6 md:static absolute top-full left-0 right-0 flex-col bg-white border-b border-accent-light md:border-0"
    >
      <a href="/" class="px-5 py-3 md:p-0 border-b md:border-0 border-accent-light font-medium text-ink hover:text-primary">Beranda</a>
      <a href="/produk" class="px-5 py-3 md:p-0 border-b md:border-0 border-accent-light font-medium text-ink hover:text-primary">Produk</a>
      <a href="/tanya-ai" class="px-5 py-3 md:p-0 border-b md:border-0 border-accent-light font-medium text-ink hover:text-primary">Tanya AI</a>
      <% if (typeof loggedIn !== 'undefined' && loggedIn) { %>
        <a href="/dashboard" class="px-5 py-3 md:p-0 border-b md:border-0 border-accent-light font-medium text-primary hover:text-primary-dark">Dashboard</a>
      <% } else { %>
        <a href="/login" class="px-5 py-3 md:p-0 border-b md:border-0 border-accent-light font-medium text-ink hover:text-primary">Login</a>
      <% } %>
    </nav>
  </div>
</header>
